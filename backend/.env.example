# Memora — Environment Configuration Example
#
# Copy this file to `.env` and fill in real values before running the
# application. Never commit a real `.env` file — only this example file
# with placeholder values should be checked into version control.
#
#   cp .env.example .env

# --------------------------
# Database
# --------------------------
# SQLAlchemy-compatible connection string. Defaults to PostgreSQL,
# intended for cloud deployment (Render/Railway/etc).
DATABASE_URL=sqlite:///./memora.db
# For local development without a Postgres instance running, use SQLite instead:
# DATABASE_URL=sqlite:///./memora.db
# postgresql+psycopg2://memora:memora@localhost:5432/memora
# --------------------------
# JWT
# --------------------------
# REQUIRED. Replace with a long, random, secret value before running the
# app. Never reuse this placeholder in any real environment.
# Generate a secure key:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------
# Environment
# --------------------------
# One of: development | testing | production
ENVIRONMENT=development
DEBUG=True

# --------------------------
# Google Gemini (Mira companion, quiz/reflection generation)
# --------------------------
# REQUIRED for Mira/quiz/reflection generation to use Gemini in
# production. Get a free-tier key at https://aistudio.google.com/apikey
# Without this set, Mira falls back to Ollama (if enabled below) or a
# deterministic template response — the app still runs, just less
# personalized.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20

# --------------------------
# Ollama (optional legacy fallback, off by default)
# --------------------------
# Only used if OLLAMA_ENABLED=true. Requires a local Ollama server.
OLLAMA_ENABLED=False
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
# 100s default fits CPU-only inference for a small model like
# qwen3:1.7b. Using a GPU? You can safely lower this to 15-20s.
OLLAMA_TIMEOUT_SECONDS=100

# --------------------------
# Development Admin Bootstrap
# --------------------------
# Optional. If BOTH are set, and no Admin account exists yet in the
# database, one Admin account is created automatically on startup.
# This is the only way to create the first Admin (there is no
# self-registration endpoint, by design). Leave blank/unset to skip.
# Never overwrites an existing admin, no matter what these contain.
DEV_ADMIN_EMAIL=admin@test.com
DEV_ADMIN_PASSWORD=replace_with_a_dev_only_password
