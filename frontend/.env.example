# Memora — Frontend Environment Configuration Example
#
# Copy this file to `.env` and adjust if the backend is hosted somewhere
# other than the local FastAPI dev server. Never commit a real `.env`
# file — only this example file should be checked into version control.
#
#   cp .env.example .env

# --------------------------
# API
# --------------------------
# Base URL of the Memora FastAPI backend. Note: backend routers
# mount at root (e.g. /auth, /students, /learning-plans) — there is no
# /api prefix.
VITE_API_BASE_URL=http://localhost:8000
